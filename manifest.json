{
  "manifest_version": 3,
  "name": "Tab Hibernator",
  "version": "1.2.2",
  "description": "Event-driven unloading of inactive tabs to reduce memory use.",
  "permissions": ["tabs", "storage", "alarms", "contextMenus"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Tab Hibernator", "default_popup": "popup.html" },
  "options_page": "options.html"
}